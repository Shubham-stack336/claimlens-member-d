# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://claimlens:claimlens@localhost:5432/claimlens
UPLOAD_DIR=./data/uploads
UPLOAD_RETENTION_HOURS=24
CORS_ORIGINS=http://localhost:5173

# 1 = return contracts/fixtures instead of calling the real modules
MOCK_AI=0
MOCK_DOCS=0

# LLM provider key (M3). Leave empty to run with MOCK_AI=1.
GROQ_API_KEY=
GEMINI_API_KEY=
