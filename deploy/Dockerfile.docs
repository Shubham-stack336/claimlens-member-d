# Standalone image for claimlens_docs: runs the tests and the eval gate.
# Works in this repo as it is (no backend needed).
#   docker build -f deploy/Dockerfile.docs -t claimlens-docs .
#   docker run --rm claimlens-docs                  # eval with the CI gate
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN useradd --create-home --uid 10001 app

COPY pyproject.toml README.md ./
COPY claimlens_docs/ claimlens_docs/
RUN pip install --no-cache-dir ".[dev]"

COPY eval/ eval/
COPY tests/ tests/
RUN chown -R app:app /app

USER app
HEALTHCHECK NONE
CMD ["sh", "-c", "pytest -q && python -m eval.run --gate --out /tmp/report.json"]
